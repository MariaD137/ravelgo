GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
API_BASE_URL=https://api.ravelgo.example.com
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AWS_REGION=us-east-1

# Device push (PushNotificationService). Leave blank to keep push a no-op —
# same AWS Pinpoint application and push-only identity pool the customer app
# uses (infra/lib/auth-stack.ts's PinpointApp / PushIdentityPool).
PINPOINT_APPLICATION_ID=
PUSH_IDENTITY_POOL_ID=

# Display currency. Defaults to Nigerian Naira (₦ / NGN) when unset; override
# per country as RavelGo expands to new markets, then rebuild.
CURRENCY_SYMBOL=₦
CURRENCY_CODE=NGN
