GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
API_BASE_URL=https://api.ravelgo.example.com
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AWS_REGION=us-east-1

# Stripe PUBLISHABLE key (pk_test_... / pk_live_...). This is safe to ship in
# the client; the SECRET key must NEVER be placed here — it lives only on the
# backend. Payments/top-ups are confirmed through Stripe's PaymentSheet using
# a clientSecret the backend returns.
STRIPE_PUBLISHABLE_KEY=

# Display currency. Defaults to Nigerian Naira (₦ / NGN) when unset; override
# per country as RavelGo expands to new markets, then rebuild — every price in
# the app follows automatically.
CURRENCY_SYMBOL=₦
CURRENCY_CODE=NGN

# Device push notifications — AWS-native (Amazon Pinpoint on the backend,
# AWS Amplify's Push Notifications category here for token acquisition only;
# no Firebase SDK). Both left empty by default, which keeps push a no-op —
# in-app notifications work fully either way. Fill these in only once the
# infra stack has been deployed with a real Pinpoint app + push identity pool
# (see infra/lib/auth-stack.ts's PinpointApp / PushIdentityPool outputs).
PINPOINT_APPLICATION_ID=
PUSH_IDENTITY_POOL_ID=
