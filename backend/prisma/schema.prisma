generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RIDER
  DRIVER
  ADMIN
}

enum DriverStatus {
  ACTIVE
  PENDING_REVIEW
  SUSPENDED
}

enum TripStatus {
  REQUESTED
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum DocumentStatus {
  NOT_UPLOADED
  PENDING
  APPROVED
  EXPIRING_SOON
  REJECTED
}

enum CarPaddyStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum RentalListingStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum CourierStatus {
  REQUESTED
  MATCHED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum AlertType {
  SOS
  FRAUD_SUSPECTED
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  CARD
  CASH
  WALLET
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id                String   @id @default(uuid())
  cognitoSub        String   @unique
  role              Role     @default(RIDER)
  firstName         String
  lastName          String
  email             String   @unique
  phoneNumber       String?
  isLoyaltyMember   Boolean  @default(false)
  suspended         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  driverProfile     Driver?
  ridesAsRider      Trip[]   @relation("RiderTrips")
  supportTickets    SupportTicket[]
  courierRequestsSent CourierRequest[] @relation("CourierSender")
  emergencyAlerts   EmergencyAlert[]
  payments          Payment[]
  promotionRedemptions PromotionRedemption[]
  bankAccount       DriverBankAccount?
  payouts           Payout[]
  wallet            WalletAccount?
  foodOrders        FoodOrder[]      @relation("RiderFoodOrders")
}

model Driver {
  id                String       @id @default(uuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            DriverStatus @default(PENDING_REVIEW)
  isOnline          Boolean      @default(false)
  rating            Float        @default(5.0)
  totalTrips        Int          @default(0)
  preferredLanguage String       @default("English")
  quietModePreferred Boolean     @default(false)
  subscriptionActive Boolean     @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  vehicles          Vehicle[]
  documents         DriverDocument[]
  tripsAsDriver     Trip[]       @relation("DriverTrips")
  carPaddyRequests  CarPaddyRequest[]
  rentalListings    RentalListing[]
  courierRequestsHandled CourierRequest[] @relation("CourierDriver")
  subscription      DriverSubscription?
}

model Vehicle {
  id               String   @id @default(uuid())
  driverId         String
  driver           Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  brand            String
  model            String
  colour           String
  plateNumber      String   @unique
  year             String
  isPrimary        Boolean  @default(false)
  listedForRental  Boolean  @default(false)
  createdAt        DateTime @default(now())

  rentalListings   RentalListing[]
}

model Trip {
  id            String     @id @default(uuid())
  riderId       String
  rider         User       @relation("RiderTrips", fields: [riderId], references: [id])
  driverId      String?
  driver        Driver?    @relation("DriverTrips", fields: [driverId], references: [id])
  pickup        String
  destination   String
  estimatedFare Float
  finalFare     Float?
  status        TripStatus @default(REQUESTED)
  category      String     @default("Personal")
  pickupNote    String?
  riderRating   Float?     // 1–5 rating the rider gave the driver for this trip
  requestedAt   DateTime   @default(now())
  completedAt   DateTime?

  payment       Payment?
  emergencyAlerts EmergencyAlert[]
}

model DriverDocument {
  id         String         @id @default(uuid())
  driverId   String
  driver     Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  title      String
  status     DocumentStatus @default(NOT_UPLOADED)
  fileKey    String?
  expiryDate DateTime?
  updatedAt  DateTime       @updatedAt
}

model CarPaddyRequest {
  id           String         @id @default(uuid())
  driverId     String
  driver       Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  plateNumber  String
  status       CarPaddyStatus @default(SUBMITTED)
  submittedAt  DateTime       @default(now())
  reviewedAt   DateTime?
}

model RentalListing {
  id         String               @id @default(uuid())
  driverId   String
  driver     Driver               @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dailyRate  Float
  location   String
  status     RentalListingStatus  @default(PENDING_APPROVAL)
  createdAt  DateTime             @default(now())
}

model SupportTicket {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  category  String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
}

model CourierRequest {
  id                  String        @id @default(uuid())
  senderId             String
  sender               User          @relation("CourierSender", fields: [senderId], references: [id])
  driverId             String?
  driver               Driver?       @relation("CourierDriver", fields: [driverId], references: [id])
  pickupAddress        String
  dropoffAddress       String
  packageDescription   String
  recipientName        String
  recipientPhone       String
  estimatedFare        Float
  finalFare            Float?
  status               CourierStatus @default(REQUESTED)
  requestedAt          DateTime      @default(now())
  deliveredAt          DateTime?
}

model EmergencyAlert {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId     String?
  trip       Trip?       @relation(fields: [tripId], references: [id])
  type       AlertType
  message    String?
  status     AlertStatus @default(OPEN)
  createdAt  DateTime    @default(now())
  resolvedAt DateTime?
}

model SubscriptionPlan {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String
  priceMonthly Float
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  subscriptions DriverSubscription[]
}

model DriverSubscription {
  id               String             @id @default(uuid())
  driverId         String             @unique
  driver           Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  planId           String
  plan             SubscriptionPlan   @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(ACTIVE)
  startedAt        DateTime           @default(now())
  currentPeriodEnd DateTime
}

model Payment {
  id                 String        @id @default(uuid())
  tripId             String        @unique
  trip               Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  amount             Float
  currency           String        @default("USD")
  method             PaymentMethod @default(CARD)
  status             PaymentStatus @default(PENDING)
  providerReference  String?
  createdAt          DateTime      @default(now())
  paidAt             DateTime?
}

// A catalog of tiers, not a stored assignment on User — the caller's current
// tier is computed on read from their completed trip count against
// minCompletedTrips, so it can never drift out of sync with actual trips.
model LoyaltyTier {
  id                String   @id @default(uuid())
  name              String   @unique
  minCompletedTrips Int
  discountPercent   Float
  perks             String?
  createdAt         DateTime @default(now())
}

model Promotion {
  id               String    @id @default(uuid())
  code             String    @unique
  description      String
  discountPercent  Float
  active           Boolean   @default(true)
  expiresAt        DateTime?
  maxRedemptions   Int?
  redemptionCount  Int       @default(0)
  createdAt        DateTime  @default(now())

  redemptions      PromotionRedemption[]
}

model PromotionRedemption {
  id          String    @id @default(uuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemedAt  DateTime  @default(now())

  @@unique([promotionId, userId])
}

// A flat rate card (base + per-km + per-minute) used to compute a fare
// quote. Only one should be `active` at a time — enforced in the route, not
// the schema, since "at most one active row" isn't expressible as a
// constraint here.
model PricingRule {
  id         String   @id @default(uuid())
  name       String   @unique
  baseFare   Float
  perKm      Float
  perMinute  Float
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model SurgeZone {
  id         String    @id @default(uuid())
  name       String    @unique
  location   String
  multiplier Float
  active     Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
}

model DriverBankAccount {
  id              String   @id @default(uuid())
  driverId        String   @unique
  driver          User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  accountHolderName String
  bankName        String
  accountNumber   String
  routingNumber   String
  accountType     String   @default("CHECKING") // CHECKING, SAVINGS
  isVerified      Boolean  @default(false)
  verificationToken String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Payout {
  id              String      @id @default(uuid())
  driverId        String
  driver          User        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  amount          Float
  currency        String      @default("USD")
  status          PayoutStatus @default(PENDING)
  period          String      // e.g., "2024-07" for weekly/monthly payout period
  transactionId   String?     // Stripe or payment provider transaction ID
  failureReason   String?
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([driverId])
  @@index([status])
  @@index([createdAt])
}

enum WalletTransactionType {
  TOPUP // rider added funds via Stripe
  RIDE_PAYMENT // rider paid for a trip from their balance
  REFUND
}

enum WalletTransactionStatus {
  PENDING // TOPUP awaiting Stripe webhook confirmation
  COMPLETED
  FAILED
}

// A rider's prepaid RavelGo balance. Held in integer cents so incremental
// credits/debits never accumulate floating-point drift. Funded only through
// Stripe top-ups (so the money is real and RavelGo holds it), and spent on
// rides — a wallet ride payment still leaves RavelGo in control of the funds,
// which is what lets the platform take its commission and remit the rest to
// the driver, exactly like a card payment (and unlike cash).
model WalletAccount {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceCents Int      @default(0)
  currency     String   @default("USD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id                String                  @id @default(uuid())
  walletId          String
  wallet            WalletAccount           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type              WalletTransactionType
  status            WalletTransactionStatus @default(COMPLETED)
  amountCents       Int // positive = credit (top-up/refund), negative = debit (ride)
  providerReference String?                 @unique // Stripe PaymentIntent id for a TOPUP
  tripId            String? // the trip a RIDE_PAYMENT paid for
  createdAt         DateTime                @default(now())

  @@index([walletId])
}

// Append-only record of privileged admin actions (driver approvals, document
// reviews, rider suspensions) for accountability. Written best-effort by the
// admin routes; readable only by Admins via GET /admin/audit.
model AuditLog {
  id         String   @id @default(uuid())
  actorSub   String // Cognito sub of the admin who performed the action
  action     String // e.g. DRIVER_STATUS_CHANGED, DOCUMENT_REVIEWED, RIDER_SUSPENDED
  entityType String // e.g. Driver, DriverDocument, User
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Eats (food delivery) marketplace — first vertical of the multi-service app.
// ---------------------------------------------------------------------------

enum FoodOrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Restaurant {
  id        String     @id @default(uuid())
  name      String
  cuisine   String
  imageUrl  String?
  address   String
  isOpen    Boolean    @default(true)
  rating    Float?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  menuItems MenuItem[]
  orders    FoodOrder[]
}

model MenuItem {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  price        Float
  imageUrl     String?
  available    Boolean    @default(true)
  createdAt    DateTime   @default(now())

  orderItems   FoodOrderItem[]

  @@index([restaurantId])
}

model FoodOrder {
  id              String          @id @default(uuid())
  riderId         String
  rider           User            @relation("RiderFoodOrders", fields: [riderId], references: [id], onDelete: Cascade)
  restaurantId    String
  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id])
  status          FoodOrderStatus @default(PLACED)
  subtotal        Float
  deliveryFee     Float
  total           Float
  deliveryAddress String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items           FoodOrderItem[]

  @@index([riderId])
  @@index([restaurantId])
}

model FoodOrderItem {
  id           String    @id @default(uuid())
  orderId      String
  order        FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId   String
  menuItem     MenuItem  @relation(fields: [menuItemId], references: [id])
  nameSnapshot String
  unitPrice    Float
  quantity     Int

  @@index([orderId])
}
