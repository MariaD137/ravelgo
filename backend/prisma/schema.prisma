generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RIDER
  DRIVER
  ADMIN
}

enum DriverStatus {
  ACTIVE
  PENDING_REVIEW
  SUSPENDED
}

enum TripStatus {
  REQUESTED
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

// The individual ride-offer lifecycle — distinct from Driver.status
// (account-level approval/suspension) and from Trip.status (the ride
// itself). See TripOffer's own doc comment for the full rationale.
enum TripOfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum DocumentStatus {
  NOT_UPLOADED
  PENDING
  APPROVED
  EXPIRING_SOON
  REJECTED
}

enum CarPaddyStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum RentalListingStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum CourierStatus {
  REQUESTED
  MATCHED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum AlertType {
  SOS
  FRAUD_SUSPECTED
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  CARD
  CASH
  WALLET
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// Which domain currently holds a driver operationally busy. One row per
// active occupation — see DriverAssignment's own comment for the invariant
// this enum backs.
enum AssignmentType {
  RIDE
  COURIER
  RENTAL
}

enum AssignmentStatus {
  ACTIVE
  ENDED
}

enum RentalBookingStatus {
  REQUESTED
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  REJECTED
}

// Ride has a real Payment model (Stripe-adjacent, tied 1:1 to Trip).
// Courier and Rental do not yet — Stripe is explicitly out of scope until a
// later integration phase. NOT_CONFIGURED is a deliberate, visible marker
// on every CourierRequest/RentalBooking rather than silently having no
// payment field at all, so a client can distinguish "payment isn't wired
// up yet" from "payment failed" or "payment succeeded" once it is. This is
// the only value today; the enum grows (PENDING/SUCCEEDED/FAILED/REFUNDED,
// mirroring PaymentStatus) when Stripe is actually integrated for these
// two domains.
enum PaymentIntegrationStatus {
  NOT_CONFIGURED
}

model User {
  id                String   @id @default(uuid())
  cognitoSub        String   @unique
  role              Role     @default(RIDER)
  firstName         String
  lastName          String
  email             String   @unique
  phoneNumber       String?
  isLoyaltyMember   Boolean  @default(false)
  suspended         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  driverProfile     Driver?
  ridesAsRider      Trip[]   @relation("RiderTrips")
  supportTickets    SupportTicket[]
  courierRequestsSent CourierRequest[] @relation("CourierSender")
  emergencyAlerts   EmergencyAlert[]
  payments          Payment[]
  promotionRedemptions PromotionRedemption[]
  bankAccount       DriverBankAccount?
  payouts           Payout[]
  rentalBookings    RentalBooking[]
}

model Driver {
  id                String       @id @default(uuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            DriverStatus @default(PENDING_REVIEW)
  // Real-time presence, distinct from `status` (admin approval state):
  // a driver toggles this from the app when they go online/offline for
  // the day. matchDriverToTrip only considers online:true drivers eligible
  // for a new ride — an ACTIVE-but-offline driver must never be assigned
  // one, the same way an ACTIVE-but-busy (has an ACTIVE DriverAssignment)
  // driver isn't. Defaults false: a driver is offline until they
  // explicitly go online, including immediately after onboarding.
  online            Boolean      @default(false)
  rating            Float        @default(5.0)
  totalTrips        Int          @default(0)
  preferredLanguage String       @default("English")
  quietModePreferred Boolean     @default(false)
  subscriptionActive Boolean     @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  vehicles          Vehicle[]
  documents         DriverDocument[]
  tripsAsDriver     Trip[]       @relation("DriverTrips")
  carPaddyRequests  CarPaddyRequest[]
  rentalListings    RentalListing[]
  courierRequestsHandled CourierRequest[] @relation("CourierDriver")
  subscription      DriverSubscription?
  assignments       DriverAssignment[]
  tripOffers        TripOffer[]
}

model Vehicle {
  id               String   @id @default(uuid())
  driverId         String
  driver           Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  brand            String
  model            String
  colour           String
  plateNumber      String   @unique
  year             String
  isPrimary        Boolean  @default(false)
  listedForRental  Boolean  @default(false)
  createdAt        DateTime @default(now())

  rentalListings   RentalListing[]
  rentalBookings   RentalBooking[]
  trips            Trip[]
  assignments      DriverAssignment[]
}

model Trip {
  id            String     @id @default(uuid())
  riderId       String
  rider         User       @relation("RiderTrips", fields: [riderId], references: [id])
  driverId      String?
  driver        Driver?    @relation("DriverTrips", fields: [driverId], references: [id])
  // Nullable: trips created before this column existed have no determinable
  // vehicle and are never backfilled (see the migration's own comment for
  // why guessing one would be inventing data). New trips get one assigned
  // by matchDriverToTrip() at match time, once the matched driver is known.
  vehicleId     String?
  vehicle       Vehicle?   @relation(fields: [vehicleId], references: [id])
  pickup        String
  destination   String
  estimatedFare Float
  finalFare     Float?
  status        TripStatus @default(REQUESTED)
  category      String     @default("Personal")
  pickupNote    String?
  requestedAt   DateTime   @default(now())
  completedAt   DateTime?

  payment       Payment?
  emergencyAlerts EmergencyAlert[]
  offers        TripOffer[]
}

// A single ride-offer sent to one specific driver at a time — the "Uber-style"
// dispatch step between a rider's REQUESTED trip and it becoming MATCHED.
// Distinct from DriverAssignment (which represents the driver actually being
// committed/busy on a job): an offer is merely a proposal a driver can accept
// or decline, and must never make the driver look "busy" in the
// DriverAssignment sense until they actually accept it — that's why this is
// its own model rather than an extra AssignmentStatus value (AssignmentType/
// AssignmentStatus are shared with Courier and Rental's own very different
// browse-and-claim / listing-activation flows, and conflating "offered" with
// "busy" there would incorrectly block a driver from other domains' work
// just for having an unanswered ride offer).
model TripOffer {
  id          String          @id @default(uuid())
  tripId      String
  trip        Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driverId    String
  driver      Driver          @relation(fields: [driverId], references: [id], onDelete: Cascade)
  status      TripOfferStatus @default(OFFERED)
  offeredAt   DateTime        @default(now())
  respondedAt DateTime?
  expiresAt   DateTime

  @@index([tripId])
  @@index([driverId, status])
}

model DriverDocument {
  id         String         @id @default(uuid())
  driverId   String
  driver     Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  title      String
  status     DocumentStatus @default(NOT_UPLOADED)
  fileKey    String?
  expiryDate DateTime?
  updatedAt  DateTime       @updatedAt
}

model CarPaddyRequest {
  id           String         @id @default(uuid())
  driverId     String
  driver       Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  plateNumber  String
  status       CarPaddyStatus @default(SUBMITTED)
  submittedAt  DateTime       @default(now())
  reviewedAt   DateTime?
}

model RentalListing {
  id         String               @id @default(uuid())
  driverId   String
  driver     Driver               @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dailyRate  Float
  location   String
  status     RentalListingStatus  @default(PENDING_APPROVAL)
  createdAt  DateTime             @default(now())

  bookings   RentalBooking[]
}

model SupportTicket {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  category  String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
}

model CourierRequest {
  id                  String        @id @default(uuid())
  senderId             String
  sender               User          @relation("CourierSender", fields: [senderId], references: [id])
  driverId             String?
  driver               Driver?       @relation("CourierDriver", fields: [driverId], references: [id])
  pickupAddress        String
  dropoffAddress       String
  packageDescription   String
  recipientName        String
  recipientPhone       String
  estimatedFare        Float
  finalFare            Float?
  status               CourierStatus @default(REQUESTED)
  paymentStatus        PaymentIntegrationStatus @default(NOT_CONFIGURED)
  requestedAt          DateTime      @default(now())
  deliveredAt          DateTime?
}

model EmergencyAlert {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId     String?
  trip       Trip?       @relation(fields: [tripId], references: [id])
  type       AlertType
  message    String?
  status     AlertStatus @default(OPEN)
  createdAt  DateTime    @default(now())
  resolvedAt DateTime?
}

model SubscriptionPlan {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String
  priceMonthly Float
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  subscriptions DriverSubscription[]
}

model DriverSubscription {
  id               String             @id @default(uuid())
  driverId         String             @unique
  driver           Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  planId           String
  plan             SubscriptionPlan   @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(ACTIVE)
  startedAt        DateTime           @default(now())
  currentPeriodEnd DateTime
}

model Payment {
  id                 String        @id @default(uuid())
  tripId             String        @unique
  trip               Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  amount             Float
  currency           String        @default("USD")
  method             PaymentMethod @default(CARD)
  status             PaymentStatus @default(PENDING)
  providerReference  String?
  createdAt          DateTime      @default(now())
  paidAt             DateTime?
}

// A catalog of tiers, not a stored assignment on User — the caller's current
// tier is computed on read from their completed trip count against
// minCompletedTrips, so it can never drift out of sync with actual trips.
model LoyaltyTier {
  id                String   @id @default(uuid())
  name              String   @unique
  minCompletedTrips Int
  discountPercent   Float
  perks             String?
  createdAt         DateTime @default(now())
}

model Promotion {
  id               String    @id @default(uuid())
  code             String    @unique
  description      String
  discountPercent  Float
  active           Boolean   @default(true)
  expiresAt        DateTime?
  maxRedemptions   Int?
  redemptionCount  Int       @default(0)
  createdAt        DateTime  @default(now())

  redemptions      PromotionRedemption[]
}

model PromotionRedemption {
  id          String    @id @default(uuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemedAt  DateTime  @default(now())

  @@unique([promotionId, userId])
}

// A flat rate card (base + per-km + per-minute) used to compute a fare
// quote. Only one should be `active` at a time — enforced in the route, not
// the schema, since "at most one active row" isn't expressible as a
// constraint here.
model PricingRule {
  id         String   @id @default(uuid())
  name       String   @unique
  baseFare   Float
  perKm      Float
  perMinute  Float
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model SurgeZone {
  id         String    @id @default(uuid())
  name       String    @unique
  location   String
  multiplier Float
  active     Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
}

model DriverBankAccount {
  id              String   @id @default(uuid())
  driverId        String   @unique
  driver          User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  accountHolderName String
  bankName        String
  accountNumber   String
  routingNumber   String
  accountType     String   @default("CHECKING") // CHECKING, SAVINGS
  isVerified      Boolean  @default(false)
  verificationToken String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Payout {
  id              String      @id @default(uuid())
  driverId        String
  driver          User        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  amount          Float
  currency        String      @default("USD")
  status          PayoutStatus @default(PENDING)
  period          String      // e.g., "2024-07" for weekly/monthly payout period
  transactionId   String?     // Stripe or payment provider transaction ID
  failureReason   String?
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([driverId])
  @@index([status])
  @@index([createdAt])
}

// The single cross-domain record of "what is this driver doing right now."
// Ride matching, courier accept, and rental activation all read/write this
// table instead of each other's — Ride/Courier/Rental stay unaware of one
// another's schema, but share this one row shape to answer "is driver X
// free" without a driver having to be asked three separate questions.
//
// Invariant: at most one ACTIVE row per driver. The status/assignmentType
// enums here are the app-level view of that invariant; the actual guarantee
// is a partial unique index added by hand in this table's migration
// (`CREATE UNIQUE INDEX ... ON "DriverAssignment"("driverId") WHERE status
// = 'ACTIVE'`) — Prisma's schema DSL has no WHERE clause for @@unique, so it
// isn't expressible here. That index is what stops two concurrent
// reservations for the same driver even if the application-level check in
// services/driver-availability.ts were ever bypassed or raced.
model DriverAssignment {
  id             String           @id @default(uuid())
  driverId       String
  driver         Driver           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  assignmentType AssignmentType
  // The Trip.id / CourierRequest.id / RentalBooking.id this occupation is
  // for. Not a Prisma relation on purpose: a single foreign key can't point
  // at three different tables depending on assignmentType, and adding three
  // nullable relation columns instead would let a row reference more than
  // one domain's record at once, which is exactly what this table exists to
  // prevent. Row shape is intentionally shallow — details of the underlying
  // ride/delivery/rental stay owned by that domain's own model.
  assignmentId   String
  vehicleId      String?
  vehicle        Vehicle?         @relation(fields: [vehicleId], references: [id])
  status         AssignmentStatus @default(ACTIVE)
  startedAt      DateTime         @default(now())
  endedAt        DateTime?

  @@index([driverId])
  @@index([assignmentType, assignmentId])
  @@index([vehicleId])
}

// A real transaction against a RentalListing (the ad). RentalListing itself
// stays listing-only — PENDING_APPROVAL/APPROVED/REJECTED describes whether
// the vehicle may be advertised, not whether it is currently being rented.
model RentalBooking {
  id              String              @id @default(uuid())
  rentalListingId String
  rentalListing   RentalListing       @relation(fields: [rentalListingId], references: [id], onDelete: Cascade)
  renterId        String
  renter          User                @relation(fields: [renterId], references: [id])
  vehicleId       String
  vehicle         Vehicle             @relation(fields: [vehicleId], references: [id])
  startAt         DateTime
  endAt           DateTime
  status          RentalBookingStatus @default(REQUESTED)
  price           Float
  paymentStatus   PaymentIntegrationStatus @default(NOT_CONFIGURED)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Overlap prevention (Part 12) is enforced transactionally in
  // services/rentals.ts, not by a DB exclusion constraint — an EXCLUDE ...
  // USING gist constraint would need the btree_gist extension enabled on
  // the target Postgres instance, which isn't something this change can ask
  // an already-provisioned RDS instance to install. This index supports the
  // transactional overlap query's WHERE clause.
  @@index([vehicleId, status])
}
