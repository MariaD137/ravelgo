generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RIDER
  DRIVER
  ADMIN
}

enum DriverStatus {
  ACTIVE
  PENDING_REVIEW
  SUSPENDED
}

enum TripStatus {
  REQUESTED
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum DocumentStatus {
  NOT_UPLOADED
  PENDING
  APPROVED
  EXPIRING_SOON
  REJECTED
}

enum CarPaddyStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum RentalListingStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum CourierStatus {
  REQUESTED
  MATCHED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum AlertType {
  SOS
  FRAUD_SUSPECTED
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  CARD
  CASH
  WALLET
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  DISPUTED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id                String   @id @default(uuid())
  cognitoSub        String   @unique
  role              Role     @default(RIDER)
  firstName         String
  lastName          String
  email             String   @unique
  phoneNumber       String?
  isLoyaltyMember   Boolean  @default(false)
  suspended         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  driverProfile     Driver?
  ridesAsRider      Trip[]   @relation("RiderTrips")
  supportTickets    SupportTicket[]
  courierRequestsSent CourierRequest[] @relation("CourierSender")
  emergencyAlerts   EmergencyAlert[]
  payments          Payment[]
  promotionRedemptions PromotionRedemption[]
  bankAccount       DriverBankAccount?
  payouts           Payout[]
}

model Driver {
  id                String       @id @default(uuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            DriverStatus @default(PENDING_REVIEW)
  rating            Float        @default(5.0)
  totalTrips        Int          @default(0)
  preferredLanguage String       @default("English")
  quietModePreferred Boolean     @default(false)
  subscriptionActive Boolean     @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  vehicles          Vehicle[]
  documents         DriverDocument[]
  tripsAsDriver     Trip[]       @relation("DriverTrips")
  carPaddyRequests  CarPaddyRequest[]
  rentalListings    RentalListing[]
  courierRequestsHandled CourierRequest[] @relation("CourierDriver")
  subscription      DriverSubscription?
}

model Vehicle {
  id               String   @id @default(uuid())
  driverId         String
  driver           Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  brand            String
  model            String
  colour           String
  plateNumber      String   @unique
  year             String
  isPrimary        Boolean  @default(false)
  listedForRental  Boolean  @default(false)
  createdAt        DateTime @default(now())

  rentalListings   RentalListing[]
}

model Trip {
  id            String     @id @default(uuid())
  riderId       String
  rider         User       @relation("RiderTrips", fields: [riderId], references: [id])
  driverId      String?
  driver        Driver?    @relation("DriverTrips", fields: [driverId], references: [id])
  pickup        String
  destination   String
  estimatedFare Float
  finalFare     Float?
  status        TripStatus @default(REQUESTED)
  category      String     @default("Personal")
  pickupNote    String?
  requestedAt   DateTime   @default(now())
  completedAt   DateTime?

  payment       Payment?
  emergencyAlerts EmergencyAlert[]
}

model DriverDocument {
  id         String         @id @default(uuid())
  driverId   String
  driver     Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  title      String
  status     DocumentStatus @default(NOT_UPLOADED)
  fileKey    String?
  expiryDate DateTime?
  updatedAt  DateTime       @updatedAt
}

model CarPaddyRequest {
  id           String         @id @default(uuid())
  driverId     String
  driver       Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  plateNumber  String
  status       CarPaddyStatus @default(SUBMITTED)
  submittedAt  DateTime       @default(now())
  reviewedAt   DateTime?
}

model RentalListing {
  id         String               @id @default(uuid())
  driverId   String
  driver     Driver               @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dailyRate  Float
  location   String
  status     RentalListingStatus  @default(PENDING_APPROVAL)
  createdAt  DateTime             @default(now())
}

model SupportTicket {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  category  String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
}

model CourierRequest {
  id                  String        @id @default(uuid())
  senderId             String
  sender               User          @relation("CourierSender", fields: [senderId], references: [id])
  driverId             String?
  driver               Driver?       @relation("CourierDriver", fields: [driverId], references: [id])
  pickupAddress        String
  dropoffAddress       String
  packageDescription   String
  recipientName        String
  recipientPhone       String
  estimatedFare        Float
  finalFare            Float?
  status               CourierStatus @default(REQUESTED)
  requestedAt          DateTime      @default(now())
  deliveredAt          DateTime?
}

model EmergencyAlert {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId     String?
  trip       Trip?       @relation(fields: [tripId], references: [id])
  type       AlertType
  message    String?
  status     AlertStatus @default(OPEN)
  createdAt  DateTime    @default(now())
  resolvedAt DateTime?
}

model SubscriptionPlan {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String
  priceMonthly Float
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  subscriptions DriverSubscription[]
}

model DriverSubscription {
  id               String             @id @default(uuid())
  driverId         String             @unique
  driver           Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  planId           String
  plan             SubscriptionPlan   @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(ACTIVE)
  startedAt        DateTime           @default(now())
  currentPeriodEnd DateTime
}

model Payment {
  id                 String        @id @default(uuid())
  tripId             String        @unique
  trip               Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  amount             Float
  currency           String        @default("USD")
  method             PaymentMethod @default(CARD)
  status             PaymentStatus @default(PENDING)
  providerReference  String?
  createdAt          DateTime      @default(now())
  paidAt             DateTime?
}

// A catalog of tiers, not a stored assignment on User — the caller's current
// tier is computed on read from their completed trip count against
// minCompletedTrips, so it can never drift out of sync with actual trips.
model LoyaltyTier {
  id                String   @id @default(uuid())
  name              String   @unique
  minCompletedTrips Int
  discountPercent   Float
  perks             String?
  createdAt         DateTime @default(now())
}

model Promotion {
  id               String    @id @default(uuid())
  code             String    @unique
  description      String
  discountPercent  Float
  active           Boolean   @default(true)
  expiresAt        DateTime?
  maxRedemptions   Int?
  redemptionCount  Int       @default(0)
  createdAt        DateTime  @default(now())

  redemptions      PromotionRedemption[]
}

model PromotionRedemption {
  id          String    @id @default(uuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemedAt  DateTime  @default(now())

  @@unique([promotionId, userId])
}

// A flat rate card (base + per-km + per-minute) used to compute a fare
// quote. Only one should be `active` at a time — enforced in the route, not
// the schema, since "at most one active row" isn't expressible as a
// constraint here.
model PricingRule {
  id         String   @id @default(uuid())
  name       String   @unique
  baseFare   Float
  perKm      Float
  perMinute  Float
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model SurgeZone {
  id         String    @id @default(uuid())
  name       String    @unique
  location   String
  multiplier Float
  active     Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
}

model DriverBankAccount {
  id              String   @id @default(uuid())
  driverId        String   @unique
  driver          User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  accountHolderName String
  bankName        String
  accountNumber   String
  routingNumber   String
  accountType     String   @default("CHECKING") // CHECKING, SAVINGS
  isVerified      Boolean  @default(false)
  verificationToken String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Payout {
  id              String      @id @default(uuid())
  driverId        String
  driver          User        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  amount          Float
  currency        String      @default("USD")
  status          PayoutStatus @default(PENDING)
  period          String      // e.g., "2024-07" for weekly/monthly payout period
  transactionId   String?     // Stripe or payment provider transaction ID
  failureReason   String?
  notes           String?
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([driverId])
  @@index([status])
  @@index([createdAt])
}

// Idempotency ledger for Stripe webhooks. `id` is Stripe's own event.id, not
// a generated uuid — inserting it is the idempotency check itself: a retried
// or replayed delivery hits the unique constraint and is skipped without
// re-applying its side effects.
model WebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}
