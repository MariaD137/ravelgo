generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RIDER
  DRIVER
  ADMIN
}

// Fixed permission presets for Admin-group users, checked by
// requireAdminPermission (lib/admin-permissions.ts) on top of the base
// requireRole("Admin") Cognito-group gate. An Admin User with no adminRole
// set (including every admin that existed before this preset system
// shipped) is treated as SUPER_ADMIN so existing admin accounts keep full
// access unless someone explicitly assigns them a restricted preset.
enum AdminRole {
  SUPER_ADMIN
  OPERATIONS_MANAGER
  SUPPORT_AGENT
  FINANCE_VIEWER
}

enum DriverStatus {
  ACTIVE
  PENDING_REVIEW
  SUSPENDED
}

enum TripStatus {
  REQUESTED
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum DocumentStatus {
  NOT_UPLOADED
  PENDING
  APPROVED
  EXPIRING_SOON
  REJECTED
}

enum CarPaddyStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum RentalListingStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum RentalBookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PropertyListingStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum StayBookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum CourierStatus {
  REQUESTED
  MATCHED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PackageSize {
  SMALL
  MEDIUM
  LARGE
}

enum AlertType {
  SOS
  FRAUD_SUSPECTED
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  CARD
  CASH
  WALLET
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id                String   @id @default(uuid())
  cognitoSub        String   @unique
  role              Role     @default(RIDER)
  firstName         String
  lastName          String
  email             String   @unique
  phoneNumber       String?
  isLoyaltyMember   Boolean  @default(false)
  suspended         Boolean  @default(false)
  // Only meaningful when role == ADMIN. Null means "no preset assigned" —
  // see the AdminRole doc comment above for why that means full access.
  adminRole         AdminRole?
  // Soft-delete marker (P0 #12). Financial relations below are RESTRICT, so a
  // user with payout/wallet/trip history cannot be hard-deleted — deactivate by
  // stamping deletedAt instead, which preserves the ledger and every FK.
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  driverProfile     Driver?
  ridesAsRider      Trip[]   @relation("RiderTrips")
  supportTickets    SupportTicket[]
  courierRequestsSent CourierRequest[] @relation("CourierSender")
  emergencyAlerts   EmergencyAlert[]
  payments          Payment[]
  promotionRedemptions PromotionRedemption[]
  bankAccount       DriverBankAccount?
  payouts           Payout[]
  wallet            WalletAccount?
  foodOrders        FoodOrder[]      @relation("RiderFoodOrders")
  hostedProperties  PropertyListing[] @relation("HostProperties")
  stayBookings      StayBooking[]     @relation("GuestStayBookings")
  rentalBookings    RentalBooking[]   @relation("RenterRentalBookings")
}

model Driver {
  id                String       @id @default(uuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            DriverStatus @default(PENDING_REVIEW)
  isOnline          Boolean      @default(false)
  rating            Float        @default(5.0)
  totalTrips        Int          @default(0)
  preferredLanguage String       @default("English")
  quietModePreferred Boolean     @default(false)
  subscriptionActive Boolean     @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  vehicles          Vehicle[]
  documents         DriverDocument[]
  tripsAsDriver     Trip[]       @relation("DriverTrips")
  carPaddyRequests  CarPaddyRequest[]
  rentalListings    RentalListing[]
  courierRequestsHandled CourierRequest[] @relation("CourierDriver")
  subscription      DriverSubscription?
  cashRemittances   CashRemittance[]
}

model Vehicle {
  id               String   @id @default(uuid())
  driverId         String
  driver           Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  brand            String
  model            String
  colour           String
  plateNumber      String   @unique
  year             String
  isPrimary        Boolean  @default(false)
  listedForRental  Boolean  @default(false)
  createdAt        DateTime @default(now())

  rentalListings   RentalListing[]
}

model Trip {
  id            String     @id @default(uuid())
  riderId       String
  rider         User       @relation("RiderTrips", fields: [riderId], references: [id])
  driverId      String?
  // Restrict (P0 #12): a completed trip must keep its link to the driver who
  // was paid out for it — deleting the driver is blocked, not silently nulled.
  driver        Driver?    @relation("DriverTrips", fields: [driverId], references: [id], onDelete: Restrict)
  pickup        String
  destination   String
  // Coordinates the fare is computed from. The server derives distance from
  // these (services never trust a client-supplied distance) — see lib/geo.ts.
  // Nullable so pre-coordinate rows remain valid.
  pickupLat     Float?
  pickupLng     Float?
  dropoffLat    Float?
  dropoffLng    Float?
  distanceKm    Float?     // server-computed great-circle distance, for audit/receipts
  estimatedFare Float
  finalFare     Float?
  status        TripStatus @default(REQUESTED)
  category      String     @default("Personal")
  pickupNote    String?
  riderRating   Float?     // 1–5 rating the rider gave the driver for this trip
  requestedAt   DateTime   @default(now())
  completedAt   DateTime?

  payment       Payment?
  emergencyAlerts EmergencyAlert[]

  // Trip is the busiest table in the product; these back the payout query
  // (driverId+status+completedAt), the matching anti-join, and trip history.
  @@index([riderId])
  @@index([driverId])
  @@index([status])
  @@index([completedAt])
}

model DriverDocument {
  id               String         @id @default(uuid())
  driverId         String
  driver           Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  title            String
  status           DocumentStatus @default(NOT_UPLOADED)
  fileKey          String?
  expiryDate       DateTime?
  // Required whenever status is set to REJECTED (enforced in the route, not
  // here, since Prisma can't express "required only for one enum value").
  // Cleared back to null on a subsequent approval so it never lingers on a
  // document that isn't actually rejected.
  rejectionReason  String?
  updatedAt        DateTime       @updatedAt
}

model CarPaddyRequest {
  id           String         @id @default(uuid())
  driverId     String
  driver       Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  plateNumber  String
  status       CarPaddyStatus @default(SUBMITTED)
  submittedAt  DateTime       @default(now())
  reviewedAt   DateTime?
}

model RentalListing {
  id         String               @id @default(uuid())
  driverId   String
  driver     Driver               @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dailyRate  Float
  location   String
  // Populated from the same Places-backed search used elsewhere (ride
  // booking, "Send a Package") once a listing is created through it.
  // Nullable so listings created before this existed remain valid.
  lat        Float?
  lng        Float?
  status     RentalListingStatus  @default(PENDING_APPROVAL)
  createdAt  DateTime             @default(now())

  bookings   RentalBooking[]
}

// A customer's reservation of a RentalListing for a date range. Mirrors
// StayBooking's shape (server-computed price, never trusted from the client)
// but additionally tracks its own payment state inline (like CourierRequest's
// fare fields) rather than joining through Payment, which is tied 1:1 to Trip.
model RentalBooking {
  id                String               @id @default(uuid())
  renterId          String
  renter            User                 @relation("RenterRentalBookings", fields: [renterId], references: [id], onDelete: Cascade)
  listingId         String
  listing           RentalListing        @relation(fields: [listingId], references: [id])
  startDate         DateTime
  endDate           DateTime
  // Server-computed from (endDate - startDate) and the listing's dailyRate at
  // booking time — never trusted from the client.
  days              Int
  totalPrice        Float
  status            RentalBookingStatus  @default(PENDING_PAYMENT)
  paymentMethod     PaymentMethod?
  paymentStatus     PaymentStatus        @default(PENDING)
  providerReference String?              @unique // Stripe PaymentIntent id, for CARD payment
  createdAt         DateTime             @default(now())

  @@index([renterId])
  @@index([listingId])
}

// Short-stay property rentals (book a place for a range of nights). Mirrors
// RentalListing's list-then-admin-approve shape, but hosting isn't tied to a
// Driver profile — any authenticated user can list or book a stay.
model PropertyListing {
  id            String                 @id @default(uuid())
  hostId        String
  host          User                   @relation("HostProperties", fields: [hostId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  address       String
  imageUrl      String?
  pricePerNight Float
  maxGuests     Int                    @default(2)
  status        PropertyListingStatus  @default(PENDING_APPROVAL)
  createdAt     DateTime               @default(now())

  bookings      StayBooking[]

  @@index([hostId])
}

model StayBooking {
  id          String            @id @default(uuid())
  guestId     String
  guest       User              @relation("GuestStayBookings", fields: [guestId], references: [id], onDelete: Cascade)
  propertyId  String
  property    PropertyListing   @relation(fields: [propertyId], references: [id])
  checkIn     DateTime
  checkOut    DateTime
  guests      Int
  // Server-computed from (checkOut - checkIn) and the listing's
  // pricePerNight at booking time — never trusted from the client.
  nights      Int
  totalPrice  Float
  status      StayBookingStatus @default(CONFIRMED)
  createdAt   DateTime          @default(now())

  @@index([guestId])
  @@index([propertyId])
}

model SupportTicket {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  category  String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
}

model CourierRequest {
  id                  String        @id @default(uuid())
  senderId             String
  sender               User          @relation("CourierSender", fields: [senderId], references: [id])
  driverId             String?
  driver               Driver?       @relation("CourierDriver", fields: [driverId], references: [id])
  pickupAddress        String
  dropoffAddress       String
  packageDescription   String
  packageSize          PackageSize   @default(MEDIUM)
  recipientName        String
  recipientPhone       String
  // Server-computed from packageSize at request time — never trusted from the client.
  estimatedFare        Float
  finalFare            Float?
  status               CourierStatus @default(REQUESTED)
  requestedAt          DateTime      @default(now())
  pickedUpAt           DateTime?
  deliveredAt          DateTime?
  // Proof of delivery — both required by the API before a request can be
  // marked DELIVERED. S3 keys (documents bucket), not public URLs; a signed
  // GET URL is generated per-request when a party fetches this record.
  deliveryPhotoKey     String?
  recipientSignatureKey String?
}

model EmergencyAlert {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId     String?
  trip       Trip?       @relation(fields: [tripId], references: [id])
  type       AlertType
  message    String?
  status     AlertStatus @default(OPEN)
  createdAt  DateTime    @default(now())
  resolvedAt DateTime?
}

model SubscriptionPlan {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String
  priceMonthly Float
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  subscriptions DriverSubscription[]
}

model DriverSubscription {
  id               String             @id @default(uuid())
  driverId         String             @unique
  driver           Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  planId           String
  plan             SubscriptionPlan   @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(ACTIVE)
  startedAt        DateTime           @default(now())
  currentPeriodEnd DateTime
}

model Payment {
  id                 String        @id @default(uuid())
  tripId             String        @unique
  trip               Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  amount             Float
  currency           String        @default("USD")
  method             PaymentMethod @default(CARD)
  status             PaymentStatus @default(PENDING)
  providerReference  String?
  createdAt          DateTime      @default(now())
  paidAt             DateTime?
}

// Single-row app-wide configuration. Read/written through lib/payment-rules.ts
// (never directly), which upserts the fixed "default" row on first read so the
// table never needs a seed step. Every change is Super-Admin-only and audited
// (see settings.routes.ts) — this is deliberately a real, server-authoritative
// setting, not a client-side constant, per the "never trust the frontend for
// money rules" requirement on the ₦15,000 cash cap.
model AppSetting {
  id                   String   @id
  // NGN. Cash is only offered as a payment option for a trip whose fare is at
  // or below this amount — see lib/payment-rules.ts#isCashPaymentAllowed.
  cashPaymentLimit     Float    @default(15000)
  cashPaymentEnabled   Boolean  @default(true)
  cardPaymentEnabled   Boolean  @default(true)
  walletPaymentEnabled Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

// A driver's physical cash hand-in, recorded by a Finance/Super admin after
// the driver remits cash collected from CASH trips. Deliberately separate
// from Payment: a Payment row is created the instant a CASH trip is marked
// paid (it's *owed* to RavelGo from that moment), while a CashRemittance only
// exists once the driver has actually handed the money over — the gap between
// the two, per driver, is exactly the "Outstanding" figure on the
// reconciliation screen.
model CashRemittance {
  id         String   @id @default(uuid())
  driverId   String
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Restrict)
  amount     Float
  note       String?
  // The recording admin's email — a simple, sufficient audit trail without
  // pulling in a full User relation for what is already itself an audited action.
  recordedBy String
  createdAt  DateTime @default(now())

  @@index([driverId])
}

// A catalog of tiers, not a stored assignment on User — the caller's current
// tier is computed on read from their completed trip count against
// minCompletedTrips, so it can never drift out of sync with actual trips.
model LoyaltyTier {
  id                String   @id @default(uuid())
  name              String   @unique
  minCompletedTrips Int
  discountPercent   Float
  perks             String?
  createdAt         DateTime @default(now())
}

model Promotion {
  id               String    @id @default(uuid())
  code             String    @unique
  description      String
  discountPercent  Float
  active           Boolean   @default(true)
  expiresAt        DateTime?
  maxRedemptions   Int?
  redemptionCount  Int       @default(0)
  createdAt        DateTime  @default(now())

  redemptions      PromotionRedemption[]
}

model PromotionRedemption {
  id          String    @id @default(uuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemedAt  DateTime  @default(now())

  @@unique([promotionId, userId])
}

// A flat rate card (base + per-km + per-minute) used to compute a fare
// quote. Only one should be `active` at a time — enforced in the route, not
// the schema, since "at most one active row" isn't expressible as a
// constraint here.
model PricingRule {
  id         String   @id @default(uuid())
  name       String   @unique
  baseFare   Float
  perKm      Float
  perMinute  Float
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model SurgeZone {
  id         String    @id @default(uuid())
  name       String    @unique
  location   String
  multiplier Float
  active     Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
}

model DriverBankAccount {
  id              String   @id @default(uuid())
  driverId        String   @unique
  driver          User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  accountHolderName String
  bankName        String
  accountNumber   String
  routingNumber   String
  accountType     String   @default("CHECKING") // CHECKING, SAVINGS
  isVerified      Boolean  @default(false)
  verificationToken String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Payout {
  id              String      @id @default(uuid())
  driverId        String
  // Restrict (P0 #12): payout history is a financial record — never destroyed
  // by deleting the user it belongs to.
  driver          User        @relation(fields: [driverId], references: [id], onDelete: Restrict)
  amount          Float
  currency        String      @default("USD")
  status          PayoutStatus @default(PENDING)
  period          String      // e.g., "2024-07" for weekly/monthly payout period
  transactionId   String?     // Stripe or payment provider transaction ID
  failureReason   String?
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Business invariant (P0 #6): one driver gets at most one payout per period.
  // The DB enforces it so a re-run of generatePayoutsForPeriod, a concurrent
  // run, or a double admin click can never pay a driver twice for one period.
  @@unique([driverId, period])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
}

enum WalletTransactionType {
  TOPUP // rider added funds via Stripe
  RIDE_PAYMENT // rider paid for a trip from their balance
  RENTAL_PAYMENT // rider paid for a car rental booking from their balance
  REFUND
}

enum WalletTransactionStatus {
  PENDING // TOPUP awaiting Stripe webhook confirmation
  COMPLETED
  FAILED
}

// A rider's prepaid RavelGo balance. Held in integer cents so incremental
// credits/debits never accumulate floating-point drift. Funded only through
// Stripe top-ups (so the money is real and RavelGo holds it), and spent on
// rides — a wallet ride payment still leaves RavelGo in control of the funds,
// which is what lets the platform take its commission and remit the rest to
// the driver, exactly like a card payment (and unlike cash).
model WalletAccount {
  id           String   @id @default(uuid())
  userId       String   @unique
  // Restrict (P0 #12): the wallet ledger is an append-only financial record —
  // deleting the owning user is blocked so the balance + transactions survive.
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  balanceCents Int      @default(0)
  currency     String   @default("USD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id                String                  @id @default(uuid())
  walletId          String
  wallet            WalletAccount           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type              WalletTransactionType
  status            WalletTransactionStatus @default(COMPLETED)
  amountCents       Int // positive = credit (top-up/refund), negative = debit (ride)
  providerReference String?                 @unique // Stripe PaymentIntent id for a TOPUP
  tripId            String? // the trip a RIDE_PAYMENT paid for
  rentalBookingId   String? // the booking a RENTAL_PAYMENT paid for
  // Cognito sub of the payer, when a TOPUP was funded by someone OTHER than the
  // wallet owner (authorized third-party funding). Null for a self top-up. The
  // ledger is append-only, so this permanently records who put money in.
  fundedBySub       String?
  createdAt         DateTime                @default(now())

  @@index([walletId])
}

// Append-only record of privileged admin actions (driver approvals, document
// reviews, rider suspensions) for accountability. Written best-effort by the
// admin routes; readable only by Admins via GET /admin/audit.
model AuditLog {
  id         String   @id @default(uuid())
  actorSub   String // Cognito sub of the admin who performed the action
  action     String // e.g. DRIVER_STATUS_CHANGED, DOCUMENT_APPROVED, DOCUMENT_REJECTED, RIDER_SUSPENDED
  entityType String // e.g. Driver, DriverDocument, User
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Eats (food delivery) marketplace — first vertical of the multi-service app.
// ---------------------------------------------------------------------------

enum FoodOrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Restaurant {
  id        String     @id @default(uuid())
  name      String
  cuisine   String
  imageUrl  String?
  address   String
  isOpen    Boolean    @default(true)
  rating    Float?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  menuItems MenuItem[]
  orders    FoodOrder[]
}

model MenuItem {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  price        Float
  imageUrl     String?
  available    Boolean    @default(true)
  createdAt    DateTime   @default(now())

  orderItems   FoodOrderItem[]

  @@index([restaurantId])
}

model FoodOrder {
  id              String          @id @default(uuid())
  riderId         String
  rider           User            @relation("RiderFoodOrders", fields: [riderId], references: [id], onDelete: Cascade)
  restaurantId    String
  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id])
  status          FoodOrderStatus @default(PLACED)
  subtotal        Float
  deliveryFee     Float
  total           Float
  deliveryAddress String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items           FoodOrderItem[]

  @@index([riderId])
  @@index([restaurantId])
}

model FoodOrderItem {
  id           String    @id @default(uuid())
  orderId      String
  order        FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId   String
  menuItem     MenuItem  @relation(fields: [menuItemId], references: [id])
  nameSnapshot String
  unitPrice    Float
  quantity     Int

  @@index([orderId])
}
