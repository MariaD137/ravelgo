generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RIDER
  DRIVER
  ADMIN
}

enum DriverStatus {
  ACTIVE
  PENDING_REVIEW
  SUSPENDED
}

enum TripStatus {
  REQUESTED
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum DocumentStatus {
  NOT_UPLOADED
  PENDING
  APPROVED
  EXPIRING_SOON
  REJECTED
}

enum CarPaddyStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum RentalListingStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum CourierStatus {
  REQUESTED
  MATCHED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum AlertType {
  SOS
  FRAUD_SUSPECTED
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  CARD
  CASH
  WALLET
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  DISPUTED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum VehicleVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED
}

enum VehicleType {
  SEDAN
  SUV
  VAN
  TRUCK
  MOTORCYCLE
  LUXURY
  OTHER
}

enum VehiclePhotoType {
  FRONT
  REAR
  LEFT_SIDE
  RIGHT_SIDE
  INTERIOR
  OTHER
}

// What kind of document this is, independent of its free-text `title` (kept
// for backward compatibility with existing rows/UI copy). Defaults to OTHER
// so existing documents created before this field existed remain valid.
enum DriverDocumentType {
  DRIVERS_LICENSE
  VEHICLE_REGISTRATION
  INSURANCE
  INSPECTION
  ROADWORTHINESS
  BACKGROUND_CHECK
  PROOF_OF_ADDRESS
  OTHER
}

model User {
  id              String   @id @default(uuid())
  cognitoSub      String   @unique
  role            Role     @default(RIDER)
  firstName       String
  lastName        String
  email           String   @unique
  phoneNumber     String?
  isLoyaltyMember Boolean  @default(false)
  suspended       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  driverProfile        Driver?
  ridesAsRider         Trip[]                @relation("RiderTrips")
  supportTickets       SupportTicket[]
  courierRequestsSent  CourierRequest[]      @relation("CourierSender")
  emergencyAlerts      EmergencyAlert[]
  payments             Payment[]
  promotionRedemptions PromotionRedemption[]
  bankAccount          DriverBankAccount?
  payouts              Payout[]
  // Admin-side reverse relations for who reviewed what — never trust a
  // client-supplied reviewer id; these are always set server-side from the
  // authenticated Admin caller's own User row (see routes).
  documentsReviewed    DriverDocument[]      @relation("DocumentReviewer")
  vehiclesVerified     Vehicle[]             @relation("VehicleVerifier")

  @@index([role])
}

model Driver {
  id                 String       @id @default(uuid())
  userId             String       @unique
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             DriverStatus @default(PENDING_REVIEW)
  rating             Float        @default(5.0)
  totalTrips         Int          @default(0)
  preferredLanguage  String       @default("English")
  quietModePreferred Boolean      @default(false)
  subscriptionActive Boolean      @default(false)
  // Persisted presence — the backend is the source of truth for online/offline,
  // not the Flutter client. isOnline/lastOnlineAt give O(1) reads for the admin
  // fleet list; DriverOnlineSession below is the append-only log used to
  // compute actual online *duration* for the driver's own daily summary.
  isOnline           Boolean      @default(false)
  lastOnlineAt       DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  vehicles               Vehicle[]
  documents              DriverDocument[]
  tripsAsDriver          Trip[]                @relation("DriverTrips")
  carPaddyRequests       CarPaddyRequest[]
  rentalListings         RentalListing[]
  courierRequestsHandled CourierRequest[]      @relation("CourierDriver")
  subscription           DriverSubscription?
  onlineSessions         DriverOnlineSession[]

  @@index([status])
}

// One row per online→offline span. `endedAt: null` means the session is
// still open (the driver is currently online) — at most one open session
// per driver at a time, enforced in src/services/presence.ts rather than a
// DB constraint (Postgres partial unique indexes aren't expressible in the
// Prisma schema DSL without a raw migration, and the service already runs
// the open/close as a single transaction).
model DriverOnlineSession {
  id        String    @id @default(uuid())
  driverId  String
  driver    Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([driverId, startedAt])
}

model Vehicle {
  id                 String                    @id @default(uuid())
  driverId           String
  driver             Driver                    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  brand              String
  model              String
  colour             String
  plateNumber        String                    @unique
  year               String
  vin                String?
  vehicleType        VehicleType               @default(OTHER)
  isPrimary          Boolean                   @default(false)
  listedForRental    Boolean                   @default(false)
  // Soft-deactivation — verification history and any past trips/rentals tied
  // to this vehicle must survive a driver "removing" it, so this is a flag,
  // never a hard delete (see PATCH /vehicles/:id/deactivate).
  isActive           Boolean                   @default(true)
  // Every new vehicle starts PENDING — there's no separate "draft" state in
  // this product; creating a vehicle is the submission.
  verificationStatus VehicleVerificationStatus @default(PENDING)
  verificationReason String?
  verifiedAt         DateTime?
  verifiedById       String?
  verifiedBy         User?                     @relation("VehicleVerifier", fields: [verifiedById], references: [id])
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  rentalListings RentalListing[]
  photos         VehiclePhoto[]
  documents      DriverDocument[]

  @@index([driverId])
}

// FRONT/REAR/etc. photos for one vehicle — deliberately a separate table
// (not a comma-separated string column) so a vehicle can hold any number of
// photos per type and each can be added/removed independently.
model VehiclePhoto {
  id           String           @id @default(uuid())
  vehicleId    String
  vehicle      Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  fileKey      String
  photoType    VehiclePhotoType @default(OTHER)
  displayOrder Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([vehicleId, displayOrder])
}

model Trip {
  id              String     @id @default(uuid())
  riderId         String
  rider           User       @relation("RiderTrips", fields: [riderId], references: [id])
  driverId        String?
  driver          Driver?    @relation("DriverTrips", fields: [driverId], references: [id])
  pickup          String
  destination     String
  estimatedFare   Float
  finalFare       Float?
  // Driver-reported trip metrics, captured at COMPLETED and used as the
  // *inputs* to the server-side fare calculation — never the fare itself.
  // See trips.routes.ts: finalFare is computed from these against the
  // active PricingRule, not accepted directly from the request body.
  distanceKm      Float?
  durationMinutes Float?
  status          TripStatus @default(REQUESTED)
  category        String     @default("Personal")
  pickupNote      String?
  requestedAt     DateTime   @default(now())
  completedAt     DateTime?

  payment         Payment?
  emergencyAlerts EmergencyAlert[]

  @@index([riderId])
  @@index([driverId])
  @@index([status])
  @@index([completedAt])
}

model DriverDocument {
  id              String             @id @default(uuid())
  driverId        String
  driver          Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  // Vehicle-specific documents (registration, insurance, inspection) point
  // here; driver-level documents (license, background check) leave this
  // null. Optional and defaulted rather than backfilled, since existing
  // rows predate the concept of a vehicle-scoped document.
  vehicleId       String?
  vehicle         Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  title           String
  documentType    DriverDocumentType @default(OTHER)
  status          DocumentStatus     @default(NOT_UPLOADED)
  fileKey         String?
  expiryDate      DateTime?
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?              @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  updatedAt       DateTime           @updatedAt

  @@index([driverId])
  @@index([vehicleId])
}

model CarPaddyRequest {
  id          String         @id @default(uuid())
  driverId    String
  driver      Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  plateNumber String
  status      CarPaddyStatus @default(SUBMITTED)
  submittedAt DateTime       @default(now())
  reviewedAt  DateTime?

  @@index([driverId])
}

model RentalListing {
  id        String              @id @default(uuid())
  driverId  String
  driver    Driver              @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dailyRate Float
  location  String
  status    RentalListingStatus @default(PENDING_APPROVAL)
  createdAt DateTime            @default(now())

  @@index([driverId])
  @@index([vehicleId])
}

model SupportTicket {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  category  String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())

  @@index([userId])
}

model CourierRequest {
  id                 String        @id @default(uuid())
  senderId           String
  sender             User          @relation("CourierSender", fields: [senderId], references: [id])
  driverId           String?
  driver             Driver?       @relation("CourierDriver", fields: [driverId], references: [id])
  pickupAddress      String
  dropoffAddress     String
  packageDescription String
  recipientName      String
  recipientPhone     String
  estimatedFare      Float
  finalFare          Float?
  status             CourierStatus @default(REQUESTED)
  requestedAt        DateTime      @default(now())
  deliveredAt        DateTime?

  @@index([senderId])
  @@index([driverId])
  @@index([status])
}

model EmergencyAlert {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId     String?
  trip       Trip?       @relation(fields: [tripId], references: [id])
  type       AlertType
  message    String?
  status     AlertStatus @default(OPEN)
  createdAt  DateTime    @default(now())
  resolvedAt DateTime?

  @@index([userId])
  @@index([tripId])
}

model SubscriptionPlan {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String
  priceMonthly Float
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  subscriptions DriverSubscription[]
}

model DriverSubscription {
  id               String             @id @default(uuid())
  driverId         String             @unique
  driver           Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  planId           String
  plan             SubscriptionPlan   @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(ACTIVE)
  startedAt        DateTime           @default(now())
  currentPeriodEnd DateTime

  @@index([planId])
}

model Payment {
  id                String        @id @default(uuid())
  tripId            String        @unique
  trip              Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  amount            Float
  currency          String        @default("USD")
  method            PaymentMethod @default(CARD)
  status            PaymentStatus @default(PENDING)
  providerReference String?
  createdAt         DateTime      @default(now())
  paidAt            DateTime?

  @@index([userId])
  @@index([providerReference])
}

// A catalog of tiers, not a stored assignment on User — the caller's current
// tier is computed on read from their completed trip count against
// minCompletedTrips, so it can never drift out of sync with actual trips.
model LoyaltyTier {
  id                String   @id @default(uuid())
  name              String   @unique
  minCompletedTrips Int
  discountPercent   Float
  perks             String?
  createdAt         DateTime @default(now())
}

model Promotion {
  id              String    @id @default(uuid())
  code            String    @unique
  description     String
  discountPercent Float
  active          Boolean   @default(true)
  expiresAt       DateTime?
  maxRedemptions  Int?
  redemptionCount Int       @default(0)
  createdAt       DateTime  @default(now())

  redemptions PromotionRedemption[]
}

model PromotionRedemption {
  id          String    @id @default(uuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemedAt  DateTime  @default(now())

  @@unique([promotionId, userId])
}

// A flat rate card (base + per-km + per-minute) used to compute a fare
// quote. Only one should be `active` at a time — enforced in the route, not
// the schema, since "at most one active row" isn't expressible as a
// constraint here.
model PricingRule {
  id        String   @id @default(uuid())
  name      String   @unique
  baseFare  Float
  perKm     Float
  perMinute Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SurgeZone {
  id         String    @id @default(uuid())
  name       String    @unique
  location   String
  multiplier Float
  active     Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
}

model DriverBankAccount {
  id                String   @id @default(uuid())
  driverId          String   @unique
  driver            User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  accountHolderName String
  bankName          String
  accountNumber     String
  routingNumber     String
  accountType       String   @default("CHECKING") // CHECKING, SAVINGS
  isVerified        Boolean  @default(false)
  verificationToken String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Payout {
  id            String       @id @default(uuid())
  driverId      String
  driver        User         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  amount        Float
  currency      String       @default("USD")
  status        PayoutStatus @default(PENDING)
  period        String // e.g., "2024-07" for weekly/monthly payout period
  transactionId String? // Stripe or payment provider transaction ID
  failureReason String?
  notes         String?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // A driver can have at most one payout per period — the database-level
  // backstop behind the check-then-create in payouts.routes.ts/services;
  // concurrent requests or a re-run batch job now fail the second insert
  // instead of silently creating a duplicate payout.
  @@unique([driverId, period])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
}

// Stripe webhook delivery ledger — one row per event.id, inserted before
// any side effect runs. A replayed/retried delivery (Stripe re-sends on
// anything but a 2xx, and can also just double-send) hits the primary key's
// unique-constraint and is skipped instead of re-applying its side effects.
// Not one of the three RLS-protected financial tables (no single owning
// user), so it's queried directly rather than through withUserContext/withBypass.
model WebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}
