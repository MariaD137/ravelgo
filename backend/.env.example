NODE_ENV=development
PORT=8080

# postgresql://<user>:<password>@<host>:5432/<database>
DATABASE_URL=postgresql://ravelgo:ravelgo@localhost:5432/ravelgo

# From the Cognito stack output (see ../infra)
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

AWS_REGION=us-east-1
DOCUMENTS_BUCKET=ravelgo-driver-documents
ASSETS_BUCKET=ravelgo-assets

# Comma-separated browser origins allowed to call this API via CORS. Only
# matters for browser-based callers (e.g. the admin web dashboard, if one
# exists) — the Flutter mobile apps don't send an Origin header, so CORS
# never applies to them. Required in production; ignored in development
# (any origin is reflected for local convenience).
ALLOWED_ORIGINS=https://admin.ravelgo.com

# From your Stripe dashboard (test mode while developing). Required in
# production; safe to leave unset in development (Stripe-backed routes give
# a clear error instead of a confusing one).
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# Server-side Google Maps Platform key for the Places/Geocoding proxy
# (/api/places/*, /api/geocode/reverse). This is SEPARATE from the browser
# Maps-JS key the web apps embed: it is never sent to a client, so restrict it
# to the backend's egress IP and to the Places + Geocoding APIs only. Optional
# in dev (the proxy returns 503 when unset); required to enable address search.
GOOGLE_MAPS_SERVER_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXX

# AWS Pinpoint application device push is sent through (see
# services/push.ts). Optional everywhere, including production — an
# unconfigured deploy simply never sends a push; every in-app notification
# still persists and lists normally. Real value comes from AuthStack's
# PinpointApplicationId output once infra is deployed (infra/lib/auth-stack.ts).
PINPOINT_APPLICATION_ID=

# In production (App Runner), DATABASE_URL above is not set directly — these
# are injected instead (see infra/lib/api-stack.ts) and assembled at boot:
# DB_HOST=...
# DB_PORT=5432
# DB_NAME=ravelgo
# DB_USERNAME=...
# DB_PASSWORD=...
