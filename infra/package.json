{
  "name": "ravelgo-infra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all",
    "deploy:staging": "cdk deploy --all --context envName=staging",
    "bootstrap-ci": "cdk deploy RavelGo-CI --require-approval never",
    "bootstrap-ci-staging": "cdk deploy RavelGo-CI-staging --context envName=staging --require-approval never"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "aws-cdk": "^2.170.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.4.2"
  }
}
